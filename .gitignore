# Secrets & environment
.env
# setup_gcp.sh writes timestamped backups when it rewrites .env; these carry a
# live PORTAL_AUTH_TOKEN and do NOT match the bare ".env" rule above.
.env.backup.*
iam_policy.json

# Runtime state (local fallbacks written by the app)
budgets.json
logging_config.json
estimates.json
model_sync.json

# User-owned pricing config (seeded from pricing.defaults.json on first run;
# edited via the Pricing & Planner UI — never clobbered by updates)
backend/pricing.json

# Build artifacts
backend/static/
frontend/dist/
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Distribution / stale artifacts
*.zip

# OS
.DS_Store

# Vitest / frontend test artifacts
frontend/coverage/
