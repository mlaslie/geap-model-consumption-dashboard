# Server Settings
PORT=8000

# Google Cloud Storage (for budgets.json persistence)
# If left empty, budgets and alerts will fall back to saving locally in budgets.json
GCS_BUCKET_NAME=

# Vertex AI SDK Configuration for FinOps Assistant
GEMINI_MODEL=gemini-3.6-flash
VERTEX_REGION=global

# BigQuery Table/View Placeholders for telemetry
BIGQUERY_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=vertex_ai_user_telemetry
BIGQUERY_VIEW=user_token_chargebacks

# Authentication
# Bearer token protecting all /api endpoints.
# Empty = unauthenticated dev mode — never deploy publicly without this set or IAP in front.
PORTAL_AUTH_TOKEN=

# Logging behavior
# Set to true to re-apply Vertex model logging configuration on every server startup.
# Disable to avoid hammering Vertex config APIs during restart storms.
APPLY_LOGGING_ON_STARTUP=false

# Fraction of requests whose full prompts and responses are logged to BigQuery (0.0–1.0).
# 1.0 captures everything; lower values reduce privacy exposure and storage cost.
LOGGING_SAMPLING_RATE=1.0

# CORS
# Comma-separated list of allowed origins for browser requests.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fallback identity (setup script variable — not read by the backend server)
# FALLBACK_IDENTITY=unattributed@unknown
# Email placeholder used by setup_bigquery_view.py for rows that cannot be
# correlated to an audit log entry. Defaults to "unattributed@unknown" if unset.
